prefix=/workspace/pgenv
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libpq
Description: PostgreSQL libpq library
URL: https://www.postgresql.org/
Version: 18.6
Requires: 
Requires.private: libssl, libcrypto
Cflags: -I${includedir}
Libs: -L${libdir} -lpq
Libs.private: -L/workspace/pgenv/lib -lpgcommon -lpgport -lssl -lgssapi_krb5 -ldl -lm -lldap
