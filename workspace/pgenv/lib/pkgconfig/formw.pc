# pkg-config file generated by gen-pkgconfig
# vile:makemode

prefix=/workspace/pgenv
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include/ncursesw
abi_version=6
major_version=6
version=6.6.20251230

Name: formw
Description: ncurses 6.6 add-on library
Version: ${version}
URL: https://invisible-island.net/ncurses
Requires.private: ncursesw
Libs:  -L/workspace/pgenv/lib -Wl,-O2 -Wl,--sort-common -Wl,--allow-shlib-undefined -Wl,-rpath,/workspace/pgenv/lib -Wl,-rpath-link,/workspace/pgenv/lib -lformw
Libs.private:  
Cflags:  -D_GNU_SOURCE -DNCURSES_WIDECHAR -I${includedir} -I/workspace/pgenv/include
